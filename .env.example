# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=assetdb
POSTGRES_USER=assetuser
# تم التعديل: ضع كلمة مرور قوية هنا
POSTGRES_PASSWORD=my_super_secret_password

# ── Connection pool tuning ────────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ── OpenAI ────────────────────────────────────────────────────────────────────
# تم التعديل: ضع مفتاحك الفعلي هنا
OPENAI_API_KEY=sk-proj-YourActualOpenAIApiKeyHere...
LLM_MODEL=gpt-4o

# ── Agent tuning ──────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# ── API-key authentication (Phase 1) ─────────────────────────────────────────
# تم التعديل: ضع سلسلة عشوائية طويلة وسرية هنا (لا تستخدم هذه القيمة في الإنتاج)
API_KEY_PEPPER=change-this-to-a-long-random-secret-in-production

# ── FastAPI / Uvicorn ────────────────────────────────────────────────────────
APP_PORT=8000
ALLOWED_HOSTS=*

# ── Admin console (Phase 2) ──────────────────────────────────────────────────
# تم التعديل: ضع كلمة مرور قوية هنا لحماية لوحة التحكم
ADMIN_PASSWORD=change-this-to-a-strong-admin-password
ADMIN_PORT=8502

# ── Customer portal (Phase 3) ────────────────────────────────────────────────
# Internal URL the portal container uses to reach the API service.
CUSTOMER_API_BASE_URL=http://app:8083
PORTAL_PORT=8503
